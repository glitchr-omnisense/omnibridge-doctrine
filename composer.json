{
    "name": "omnibridge/doctrine",
    "description": "The storage glue of omnibase sites, framework-free: the naming strategy that turns their entities into their tables, the UTC date types, and an entity manager built with them, for any framework reading the same database.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer"
        }
    ],
    "require": {
        "php": ">=8.2",
        "doctrine/dbal": "^4.2",
        "doctrine/orm": "^3.4",
        "symfony/cache": "^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Omnibridge\\Doctrine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Omnibridge\\Doctrine\\Tests\\": "tests/",
            "App\\Entity\\": "tests/Fixtures/Entity/"
        }
    }
}
