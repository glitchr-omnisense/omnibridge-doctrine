# PHPStan at the highest level. phpstan-baseline.neon lists the violations there were when the CI
# started (2026-10-21, written by glitchr-studio/ci's baseline workflow): the CI fails on any other.
# Fix one, then drop its entry.
includes:
    - phpstan-baseline.neon

parameters:
    level: max
    paths:
        - src
        - tests
    # omnibase's part (Omnibridge\Doctrine\Omnibase\, moved from omnisense/omnibase at its plan "omnibase
    # agnostic"'s step F3) extends and calls the core's classes, which this package does not install (the
    # core requires it): it is analysed with the core, in the core's CI and harness.
    excludePaths:
        - src/Omnibase
    reportUnmatchedIgnoredErrors: false
